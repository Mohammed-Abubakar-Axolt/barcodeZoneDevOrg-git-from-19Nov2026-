        <div id="barcode{!HTMLENCODE(SObjectParentId)}" style="display:none"></div> 
                    
               <script type="text/javascript">
               
               jQuery(function() {
                     var qr = barcodezone.processor.qrProcessor;
                         qr.generateQR("{!JSENCODE(Height)}","{!JSENCODE(Width)}",2, "barcode{!HTMLENCODE(SObjectParentId)}", "{!JSENCODE(Brcd)}");

                       var imageData = document.getElementById("BRCDbarcode{!HTMLENCODE(SObjectParentId)}").toDataURL().split(',')[1];
                       
