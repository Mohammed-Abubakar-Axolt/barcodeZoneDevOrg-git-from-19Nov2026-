                           */                      
                              
                             /* var img = $('<img>').attr('src', '/servlet/servlet.FileDownload?file='+result[0].id);
                               img.appendTo('#'+'brcd{!HTMLENCODE(SObjectParentId)}');
                             */
                            /*var img = new Image();
